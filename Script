-- ESP / Aimbot 描画用プール
local espObjects = {}
local targetIndicator = nil

-- ターゲット選択 (視点矯正なし)
local function GetClosestEnemy()
    local closest = nil
    local closestDist = math.huge
    local myTeam = Player.Team
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == Player then continue end
        local char = plr.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Humanoid") then continue end
        if char.Humanoid.Health <= 0 then continue end
        if getgenv().FPSConfig.TeamCheck and plr.Team == myTeam then continue end
        
        local root = char.HumanoidRootPart
        local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
        if not onScreen then 
            -- 画面外でも距離計算のために続行（壁越えターゲット用）
        end
        local dist = (root.Position - Camera.CFrame.Position).magnitude
        if dist < closestDist then
            closestDist = dist
            closest = plr
        end
    end
    return closest
end

-- メインループ
RunService.RenderStepped:Connect(function()
    local config = getgenv().FPSConfig
    local espEnabled = config.ESP
    local aimbotEnabled = config.Aimbot

    -- 現在のターゲットを更新
    local target = nil
    if aimbotEnabled then
        target = GetClosestEnemy()
    end

    -- ステータス更新
    statusLabel.Text = target and ("Target: " .. target.Name) or "Target: None"
    statusLabel.TextColor3 = target and Color3.fromRGB(255, 200, 0) or Color3.fromRGB(200, 200, 200)

    -- 描画オブジェクトのクリーンアップ管理
    local activePlayers = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == Player then continue end
        local char = plr.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then continue end
        if char.Humanoid.Health <= 0 then continue end
        if config.TeamCheck and plr.Team == Player.Team then continue end
        activePlayers[plr] = true

        local root = char.HumanoidRootPart
        local head = char:FindFirstChild("Head") or root
        local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
        local headPos, _ = Camera:WorldToViewportPoint(head.Position)

        -- データ保存
        local data = espObjects[plr]
        if not data then
            data = {}
            -- Box
            local box = Instance.new("Frame")
            box.BackgroundTransparency = 0.7
            box.BorderSizePixel = 2
            box.BorderColor3 = Color3.fromRGB(0, 200, 255)
            box.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
            box.Visible = false
            box.Parent = ScreenGui

            -- Name
            local nameLbl = Instance.new("TextLabel")
            nameLbl.BackgroundTransparency = 1
            nameLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
            nameLbl.TextStrokeTransparency = 0.5
            nameLbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
            nameLbl.Font = Enum.Font.GothamBold
            nameLbl.TextSize = 12
            nameLbl.Text = plr.Name
            nameLbl.Visible = false
            nameLbl.Parent = ScreenGui

            data.Box = box
            data.NameLbl = nameLbl
            espObjects[plr] = data
        end

        -- サイズ計算 (頭と足で箱を作る)
        local footPos, _ = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))
        local height = math.abs(headPos.Y - footPos.Y)
        local width = height * 0.5
        local centerX = pos.X
        local topY = math.min(headPos.Y, footPos.Y) - height * 0.1

        -- ESP表示
        if espEnabled and onScreen then
            data.Box.Visible = true
            data.Box.Size = UDim2.new(0, width, 0, height)
            data.Box.Position = UDim2.new(0, centerX - width/2, 0, topY)

            -- ターゲットなら赤枠＋太枠、それ以外は青
            if target and plr == target then
                data.Box.BorderColor3 = Color3.fromRGB(255, 50, 50)
                data.Box.BorderSizePixel = 3
                data.Box.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
                data.Box.BackgroundTransparency = 0.8
            else
                data.Box.BorderColor3 = Color3.fromRGB(0, 200, 255)
                data.Box.BorderSizePixel = 2
                data.Box.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                data.Box.BackgroundTransparency = 0.7
            end

            data.NameLbl.Visible = true
            data.NameLbl.Size = UDim2.new(0, width + 10, 0, 16)
            data.NameLbl.Position = UDim2.new(0, centerX - (width + 10)/2, 0, topY - 16)
        else
            data.Box.Visible = false
            data.NameLbl.Visible = false
        end
    end

    -- 非アクティブなプレイヤーのオブジェクトを非表示
    for plr, data in pairs(espObjects) do
        if not activePlayers[plr] then
            data.Box.Visible = false
            data.NameLbl.Visible = false
        end
    end
end)

-- プレイヤー退出時のクリーンアップ
Players.PlayerRemoving:Connect(function(plr)
    local data = espObjects[plr]
    if data then
        data.Box:Destroy()
        data.NameLbl:Destroy()
        espObjects[plr] = nil
    end
end)

