--// Helpers
local function IsTeammate(player)
    if not TeamCheck then return false end
    if not LocalPlayer.Team or not player.Team then return false end
    return LocalPlayer.Team == player.Team
end

local function GetChar(player)
    return player.Character
end

local function IsAlive(char)
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function W2S(pos)
    local p, onScreen = Camera:WorldToViewportPoint(pos)
    return Vector2.new(p.X, p.Y), onScreen, p.Z
end

--// ESP Creation
local function CreateESP(player)
    if player == LocalPlayer then return end
    local t = {
        Box = Drawing.new("Square"),
        BoxOutline = Drawing.new("Square"),
        Name = Drawing.new("Text"),
        Dist = Drawing.new("Text"),
        HealthBar = Drawing.new("Square"),
        HealthOutline = Drawing.new("Square"),
        Tracer = Drawing.new("Line")
    }
    
    t.Box.Thickness = 1
    t.Box.Filled = false
    t.Box.Color = Color3.fromRGB(255, 50, 50)
    t.Box.Transparency = 1
    
    t.BoxOutline.Thickness = 3
    t.BoxOutline.Filled = false
    t.BoxOutline.Color = Color3.fromRGB(0, 0, 0)
    t.BoxOutline.Transparency = 1
    
    t.Name.Size = 13
    t.Name.Center = true
    t.Name.Outline = true
    t.Name.Color = Color3.fromRGB(255, 255, 255)
    
    t.Dist.Size = 12
    t.Dist.Center = true
    t.Dist.Outline = true
    t.Dist.Color = Color3.fromRGB(200, 200, 200)
    
    t.HealthBar.Thickness = 1
    t.HealthBar.Filled = true
    
    t.HealthOutline.Thickness = 1
    t.HealthOutline.Filled = true
    t.HealthOutline.Color = Color3.fromRGB(0, 0, 0)
    
    t.Tracer.Thickness = 1
    t.Tracer.Color = Color3.fromRGB(255, 50, 50)
    
    ESP_Objects[player] = t
end

local function RemoveESP(player)
    local t = ESP_Objects[player]
    if t then
        for _, v in pairs(t) do v:Remove() end
        ESP_Objects[player] = nil
    end
end

--// WallHack (Highlight)
local function CreateHighlight(player)
    if player == LocalPlayer then return end
    local hl = Instance.new("Highlight")
    hl.Name = "WH_" .. player.Name
    hl.FillColor = Color3.fromRGB(255, 0, 0)
    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.FillTransparency = 0.6
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Enabled = false
    Highlights[player] = hl
end

local function RemoveHighlight(player)
    local hl = Highlights[player]
    if hl then
        hl:Destroy()
        Highlights[player] = nil
    end
end

--// Update ESP
local function UpdateESP()
    for player, obj in pairs(ESP_Objects) do
        local char = GetChar(player)
        local head = char and char:FindFirstChild("Head")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        
        if ESP_Enabled and char and head and root and hum and IsAlive(char) and not IsTeammate(player) then
            local headPos, headVis, _ = W2S(head.Position)
            local rootPos, rootVis, _ = W2S(root.Position)
            
            if headVis and rootVis then
                local h = math.abs(headPos.Y - rootPos.Y) * 1.9
                local w = h * 0.55
                local pos = Vector2.new(headPos.X - w / 2, headPos.Y - h * 0.12)
                
                obj.Box.Size = Vector2.new(w, h)
                obj.Box.Position = pos
                obj.Box.Visible = true
                
                obj.BoxOutline.Size = Vector2.new(w, h)
                obj.BoxOutline.Position = pos
                obj.BoxOutline.Visible = true
                
                obj.Name.Position = Vector2.new(headPos.X, pos.Y - 18)
                obj.Name.Text = player.Name
                obj.Name.Visible = true
                
                local dist = math.floor((root.Position - Camera.CFrame.Position).Magnitude)
                obj.Dist.Position = Vector2.new(headPos.X, pos.Y + h + 3)
                obj.Dist.Text = dist .. "m"
                obj.Dist.Visible = true
                
                local hp = hum.Health / hum.MaxHealth
                local barH = h * hp
                obj.HealthBar.Size = Vector2.new(3, barH)
                obj.HealthBar.Position = Vector2.new(pos.X - 7, pos.Y + (h - barH))
                obj.HealthBar.Color = Color3.fromRGB(255 * (1 - hp), 255 * hp, 0)
                obj.HealthBar.Visible = true
                
                obj.HealthOutline.Size = Vector2.new(3, h)
                obj.HealthOutline.Position = Vector2.new(pos.X - 7, pos.Y)
                obj.HealthOutline.Visible = true
                
                obj.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                obj.Tracer.To = Vector2.new(headPos.X, pos.Y + h)
                obj.Tracer.Visible = true
            else
                for _, v in pairs(obj) do v.Visible = false end
            end
        else
            for _, v in pairs(obj) do v.Visible = false end
        end
    end
end

--// Update WallHack
local function UpdateWallHack()
    for player, hl in pairs(Highlights) do
        local char = GetChar(player)
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        
        if WallHack_Enabled and char and hum and IsAlive(char) and not IsTeammate(player) then
            hl.Parent = char
            hl.Enabled = true
            local hp = hum.Health / hum.MaxHealth
            hl.FillColor = Color3.fromRGB(255 * (1 - hp), 255 * hp, 0)
        else
            hl.Enabled = false
            hl.Parent = nil
        end
    end
end

--// Aimbot
local function GetClosestEnemy()
    local closest, closestDist = nil, Aimbot_FOV
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and not IsTeammate(plr) then
            local char = GetChar(plr)
            local head = char and char:FindFirstChild("Head")
            if head and IsAlive(char) then
                local pos, onScreen = W2S(head.Position)
                if onScreen then
                    local d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    if d < closestDist then
                        closestDist = d
                        closest = head
                    end
                end
            end
        end
    end
    return closest
end

local function RunAimbot()
    if not Aimbot_Enabled then return end
    local target = GetClosestEnemy()
    if target then
        local cf = CFrame.new(Camera.CFrame.Position, target.Position)
        Camera.CFrame = Camera.CFrame:Lerp(cf, Aimbot_Smooth)
    end
end

