local function MakeToggle(parent, y, name, configKey)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 30)
    btn.Position = UDim2.new(0.05, 0, 0, y)
    btn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    btn.BorderSizePixel = 0
    btn.Text = name .. ": ON"
    btn.TextColor3 = Color3.fromRGB(0, 255, 100)
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 14
    btn.Parent = parent

    btn.MouseButton1Click:Connect(function()
        local cfg = getgenv().FPSConfig
        cfg[configKey] = not cfg[configKey]
        btn.Text = name .. ": " .. (cfg[configKey] and "ON" or "OFF")
        btn.TextColor3 = cfg[configKey] and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(255, 80, 80)
        Notify("Toggle", name .. " " .. (cfg[configKey] and "ON" or "OFF"), 1)
    end)
    return btn
end

