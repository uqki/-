-- ドラッグ機能 (モバイルタッチ対応)
local dragInfo = { dragging = false, startPos = nil, frameStart = nil }

titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragInfo.dragging = true
        dragInfo.startPos = input.Position
        dragInfo.frameStart = mainFrame.Position
    end
end)

titleBar.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragInfo.dragging = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragInfo.dragging and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
        local delta = input.Position - dragInfo.startPos
        mainFrame.Position = UDim2.new(
            dragInfo.frameStart.X.Scale,
            dragInfo.frameStart.X.Offset + delta.X,
            dragInfo.frameStart.Y.Scale,
            dragInfo.frameStart.Y.Offset + delta.Y
        )
    end
end)

