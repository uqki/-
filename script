-- Slider Logic (Mobile Touch Support)
local slidingFOV = false
local slidingRange = false

local function UpdateFOV(input)
    local pos = math.clamp((input.Position.X - FOVBg.AbsolutePosition.X) / FOVBg.AbsoluteSize.X, 0, 1)
    local val = math.floor(30 + pos * 90)
    Settings.FOV = val
    Camera.FieldOfView = val
    FOVLabel.Text = "FOV: " .. val
    FOVFill.Size = UDim2.new(pos, 0, 1, 0)
    FOVBtn.Position = UDim2.new(pos, -10, 0, -6)
end

local function UpdateRange(input)
    local pos = math.clamp((input.Position.X - RangeBg.AbsolutePosition.X) / RangeBg.AbsoluteSize.X, 0, 1)
    local val = math.floor(50 + pos * 450)
    Settings.AimbotRange = val
    RangeLabel.Text = "Aim Range: " .. val
    RangeFill.Size = UDim2.new(pos, 0, 1, 0)
    RangeBtn.Position = UDim2.new(pos, -10, 0, -6)
end

FOVBtn.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then slidingFOV = true end end)
FOVBg.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then slidingFOV = true UpdateFOV(i) end end)
RangeBtn.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then slidingRange = true end end)
RangeBg.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then slidingRange = true UpdateRange(i) end end)

UserInputService.InputChanged:Connect(function(i)
    if slidingFOV and (i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseMovement) then UpdateFOV(i) end
    if slidingRange and (i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseMovement) then UpdateRange(i) end
end)

UserInputService.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
        slidingFOV = false
        slidingRange = false
    end
end)

-- Drag System (Mobile)
local dragging = false
local dragStart, startPos

TitleBar.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = i.Position
        startPos = MainFrame.Position
    end
end)

UserInputService.InputChanged:Connect(function(i)
    if dragging and (i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseMovement) then
        local delta = i.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

UserInputService.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
end)

