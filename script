-- Slider Factory
local activeSlider = nil

local function CreateSlider(name, key, y, min, max, suffix, isFloat, color)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, 0, 0, 55)
    f.Position = UDim2.new(0, 0, 0, y)
    f.BackgroundTransparency = 1
    f.Parent = Content

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 0, 22)
    lbl.BackgroundTransparency = 1
    lbl.Text = name .. ": " .. (isFloat and string.format("%.2f", Settings[key]) or Settings[key]) .. (suffix or "")
    lbl.TextColor3 = Color3.fromRGB(210, 210, 210)
    lbl.TextSize = 14
    lbl.Font = Enum.Font.Gotham
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = f

    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, 0, 0, 10)
    track.Position = UDim2.new(0, 0, 0, 32)
    track.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    track.BorderSizePixel = 0
    track.Parent = f
    Instance.new("UICorner", track).CornerRadius = UDim.new(0, 5)

    local fill = Instance.new("Frame")
    local percent = (Settings[key] - min) / (max - min)
    fill.Size = UDim2.new(percent, 0, 1, 0)
    fill.BackgroundColor3 = color or Color3.fromRGB(0, 150, 255)
    fill.BorderSizePixel = 0
    fill.Parent = track
    Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 5)

    local knob = Instance.new("TextButton")
    knob.Size = UDim2.new(0, 22, 0, 22)
    knob.Position = UDim2.new(percent, -11, 0, -6)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.Text = ""
    knob.Parent = track
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local function UpdateFromInput(input)
        local absX = track.AbsolutePosition.X
        local absW = track.AbsoluteSize.X
        local pos = math.clamp((input.Position.X - absX) / absW, 0, 1)
        local val = isFloat and (min + pos * (max - min)) or math.floor(min + pos * (max - min))
        Settings[key] = isFloat and math.floor(val * 100) / 100 or val
        lbl.Text = name .. ": " .. (isFloat and string.format("%.2f", Settings[key]) or Settings[key]) .. (suffix or "")
        fill.Size = UDim2.new(pos, 0, 1, 0)
        knob.Position = UDim2.new(pos, -11, 0, -6)
        if key == "FOV" then Camera.FieldOfView = Settings.FOV end
    end

    knob.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
            activeSlider = {track = track, fill = fill, knob = knob, lbl = lbl, min = min, max = max, key = key, suffix = suffix, isFloat = isFloat, name = name}
        end
    end)
    track.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
            activeSlider = {track = track, fill = fill, knob = knob, lbl = lbl, min = min, max = max, key = key, suffix = suffix, isFloat = isFloat, name = name}
            UpdateFromInput(i)
        end
    end)
end

