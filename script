-- Toggle Factory
local function CreateToggle(name, key, y)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, 0, 0, 38)
    f.Position = UDim2.new(0, 0, 0, y)
    f.BackgroundTransparency = 1
    f.Parent = Content

