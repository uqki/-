-- Slider Logic
local activeSlider = nil

local function UpdateSlider(input, track, fill, knob, label, min, max, settingKey, suffix)
    local absX = track.AbsolutePosition.X
    local absW = track.AbsoluteSize.X
    local pos = math.clamp((input.Position.X - absX) / absW, 0, 1)
    local val = math.floor(min + pos * (max - min))
    Settings[settingKey] = val
    label.Text = (settingKey == "FOV" and "FOV: " or "Aim Range: ") .. val .. (suffix or "")
    fill.Size = UDim2.new(pos, 0, 1, 0)
    knob.Position = UDim2.new(pos, -11, 0, -6)
    if settingKey == "FOV" then
        Camera.FieldOfView = val
    end
    return val
end

local function SetupSlider(knob, track, fill, label, min, max, key, suffix)
    knob.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
            activeSlider = {track, fill, knob, label, min, max, key, suffix}
        end
    end)
    track.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
            activeSlider = {track, fill, knob, label, min, max, key, suffix}
            UpdateSlider(i, track, fill, knob, label, min, max, key, suffix)
        end
    end)
end

SetupSlider(FOVKnob, FOVTrack, FOVFill, FOVLabel, 30, 120, "FOV")
SetupSlider(RangeKnob, RangeTrack, RangeFill, RangeLabel, 50, 500, "AimbotRange")

UserInputService.InputChanged:Connect(function(i)
    if activeSlider and (i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseMovement) then
        UpdateSlider(i, activeSlider[1], activeSlider[2], activeSlider[3], activeSlider[4], activeSlider[5], activeSlider[6], activeSlider[7], activeSlider[8])
    end
end)

UserInputService.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
        activeSlider = nil
    end
end)

