-- ESP System
local Highlights = {}
local Billboards = {}

local function CreateESP(player)
    if player == LocalPlayer then return end
    local char = player.Character
    if not char then return end
    if Settings.TeamCheck and player.Team == LocalPlayer.Team then return end

    if not char:FindFirstChild("FPSESP_H") then
        local hl = Instance.new("Highlight")
        hl.Name = "FPSESP_H"
        hl.FillColor = Settings.ESPColor
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.FillTransparency = 0.7
        hl.OutlineTransparency = 0
        hl.Adornee = char
        hl.Parent = char
        Highlights[player] = hl
    end

    if not char:FindFirstChild("FPSESP_B") then
        local bg = Instance.new("BillboardGui")
        bg.Name = "FPSESP_B"
        bg.Size = UDim2.new(0, 100, 0, 40)
        bg.StudsOffset = Vector3.new(0, 3, 0)
        bg.AlwaysOnTop = true

        local nl = Instance.new("TextLabel")
        nl.Size = UDim2.new(1, 0, 0.5, 0)
        nl.BackgroundTransparency = 1
        nl.Text = player.Name
        nl.TextColor3 = Settings.ESPColor
        nl.TextSize = 12
        nl.Font = Enum.Font.GothamBold
        nl.Parent = bg

        local dl = Instance.new("TextLabel")
        dl.Size = UDim2.new(1, 0, 0.5, 0)
        dl.Position = UDim2.new(0, 0, 0.5, 0)
        dl.BackgroundTransparency = 1
        dl.Text = "0m"
        dl.TextColor3 = Color3.fromRGB(255, 255, 255)
        dl.TextSize = 10
        dl.Font = Enum.Font.Gotham
        dl.Parent = bg

        bg.Parent = char
        Billboards[player] = bg
    end
end

local function ClearESP()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local h = p.Character:FindFirstChild("FPSESP_H")
            if h then h:Destroy() end
            local b = p.Character:FindFirstChild("FPSESP_B")
            if b then b:Destroy() end
        end
    end
    Highlights = {}
    Billboards = {}
end

-- Aimbot
local function GetTarget()
    local closest = nil
    local minDist = Settings.AimbotRange
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end
    local myPos = myChar.HumanoidRootPart.Position

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
            if Settings.TeamCheck and p.Team == LocalPlayer.Team then continue end
            local head = p.Character.Head
            local dist = (head.Position - myPos).Magnitude
            if dist < minDist then
                local ray = Ray.new(Camera.CFrame.Position, (head.Position - Camera.CFrame.Position).Unit * dist)
                local hit = Workspace:FindPartOnRayWithIgnoreList(ray, {myChar, Camera})
                if hit and (hit:IsDescendantOf(p.Character) or hit.Transparency > 0.5) then
                    closest = head
                    minDist = dist
                end
            end
        end
    end
    return closest
end

-- Third Person
local tpConnection = nil
local function UpdateThirdPerson()
    if Settings.ThirdPerson then
        if not tpConnection then
            tpConnection = RunService.RenderStepped:Connect(function()
                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    local hrp = LocalPlayer.Character.HumanoidRootPart
                    local camPos = hrp.Position - hrp.CFrame.LookVector * 8 + Vector3.new(0, 3, 0)
                    Camera.CFrame = CFrame.new(camPos, hrp.Position + Vector3.new(0, 2, 0))
                end
            end)
        end
    else
        if tpConnection then
            tpConnection:Disconnect()
            tpConnection = nil
        end
    end
end

-- Main Loop
RunService.RenderStepped:Connect(function()
    if Settings.ESP then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                if Settings.TeamCheck and p.Team == LocalPlayer.Team then
                    local h = p.Character:FindFirstChild("FPSESP_H")
                    if h then h:Destroy() end
                    local b = p.Character:FindFirstChild("FPSESP_B")
                    if b then b:Destroy() end
                else
                    CreateESP(p)
                    local bg = Billboards[p]
                    if bg and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        local d = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude)
                        bg.DistLabel.Text = d .. "m"
                        bg.NameLabel.TextColor3 = Settings.ESPColor
                    end
                    local hl = Highlights[p]
                    if hl then hl.FillColor = Settings.ESPColor end
                end
            end
        end
    else
        ClearESP()
    end

    if Settings.Aimbot then
        local t = GetTarget()
        if t then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, t.Position)
        end
    end

    UpdateThirdPerson()
end)

