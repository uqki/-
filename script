-- 7. Third Person
-- ============================================================
local ThirdPerson_Enabled = false
local ThirdPersonConnection = nil
local SavedCamType = nil
local SavedCamSubject = nil

local function ToggleThirdPerson(state)
    if state then
        SavedCamType = Camera.CameraType
        SavedCamSubject = Camera.CameraSubject
        Notify("Third Person", "Enabled", 2)
        ThirdPersonConnection = RunService.RenderStepped:Connect(function()
            if not ThirdPerson_Enabled then return end
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                Camera.CameraType = Enum.CameraType.Scriptable
                local hrp = char.HumanoidRootPart
                Camera.CFrame = CFrame.new(hrp.Position + Vector3.new(0, 2.5, 8), hrp.Position + Vector3.new(0, 1, 0))
            end
        end)
    else
        Notify("Third Person", "Disabled", 2)
        if ThirdPersonConnection then
            ThirdPersonConnection:Disconnect()
            ThirdPersonConnection = nil
        end
        Camera.CameraType = SavedCamType or Enum.CameraType.Custom
        if LocalPlayer.Character then
            Camera.CameraSubject = SavedCamSubject or LocalPlayer.Character:FindFirstChild("Humanoid")
        end
    end
end

