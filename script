local function RemoveESP(player)
    local data = ESP_Storage[player]
    if data then
        data.Container:Destroy()
        data.Tracer:Destroy()
        ESP_Storage[player] = nil
    end
end

local function UpdateESP()
    if not ESP_Enabled then
        for _, d in pairs(ESP_Storage) do
            d.Container.Visible = false
            d.Tracer.Visible = false
        end
        return
    end

    local screenW = Camera.ViewportSize.X
    local screenH = Camera.ViewportSize.Y
    local bottomCenter = Vector2.new(screenW / 2, screenH)

    for player, data in pairs(ESP_Storage) do
        local char = data.Char
        if not char then
            data.Container.Visible = false
            data.Tracer.Visible = false
            continue
        end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")
        local hum = char:FindFirstChildOfClass("Humanoid")

        if not hrp or not head then
            data.Container.Visible = false
            data.Tracer.Visible = false
            continue
        end

        local rootPos, rootOnScreen = Camera:WorldToViewportPoint(hrp.Position)
        local headPos = Camera:WorldToViewportPoint(head.Position)

        -- FIX: Check Z > 0 to avoid behind-camera rendering
        if rootOnScreen and rootPos.Z > 0 then
            local height = math.abs(headPos.Y - rootPos.Y) * 2.1
            local width = height * 0.55
            if width < 20 then width = 20 end
            if height < 30 then height = 30 end

            local dist = (hrp.Position - Camera.CFrame.Position).Magnitude
            local isTeam = IsTeammate(player)
            local color = isTeam and Color3.fromRGB(50, 255, 100) or Color3.fromRGB(255, 60, 60)

            -- Update Box
            data.Stroke.Color = color
            data.Container.Size = UDim2.new(0, width, 0, height)
            data.Container.Position = UDim2.new(0, rootPos.X - width / 2, 0, rootPos.Y - height / 2)
            data.Container.Visible = true

            -- Update Health
            if hum then
                local pct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                data.HpBar.Size = UDim2.new(1, 0, pct, 0)
                data.HpBar.Position = UDim2.new(0, 0, 1 - pct, 0)
                data.HpBar.BackgroundColor3 = Color3.fromRGB(255 * (1 - pct), 255 * pct, 60)
                data.HpBg.Visible = true
            else
                data.HpBg.Visible = false
            end

            -- Update Text
            data.Dist.Text = math.floor(dist) .. " studs"

            -- Update Tracer
            local playerScreen = Vector2.new(rootPos.X, rootPos.Y + height / 2)
            local diff = playerScreen - bottomCenter
            local len = diff.Magnitude
            local angle = math.deg(math.atan2(diff.Y, diff.X))

            data.Tracer.Position = UDim2.new(0, bottomCenter.X, 0, bottomCenter.Y)
            data.Tracer.Size = UDim2.new(0, len, 0, 1.2)
            data.Tracer.Rotation = angle
            data.Tracer.BackgroundColor3 = color
            data.Tracer.Visible = true
        else
            data.Container.Visible = false
            data.Tracer.Visible = false
        end
    end
end

