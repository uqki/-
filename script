local function RemoveESP(player)
    local data = ESP_Storage[player]
    if not data then return end
    if data.CharacterAddedConnection then data.CharacterAddedConnection:Disconnect() end
    if data.CharacterRemovingConnection then data.CharacterRemovingConnection:Disconnect() end
    if data.Container then data.Container:Destroy() end
    if data.Tracer then data.Tracer:Destroy() end
    ESP_Storage[player] = nil
end

local function GetScreenBounds(character)
    local success, boxCFrame, boxSize = pcall(function()
        return character:GetBoundingBox()
    end)
    if not success or not boxCFrame or not boxSize then return nil end

    local half = boxSize / 2
    local corners = {
        Vector3.new(-half.X, -half.Y, -half.Z),
        Vector3.new(-half.X, -half.Y,  half.Z),
        Vector3.new(-half.X,  half.Y, -half.Z),
        Vector3.new(-half.X,  half.Y,  half.Z),
        Vector3.new( half.X, -half.Y, -half.Z),
        Vector3.new( half.X, -half.Y,  half.Z),
        Vector3.new( half.X,  half.Y, -half.Z),
        Vector3.new( half.X,  half.Y,  half.Z)
    }

    local minX, minY = math.huge, math.huge
    local maxX, maxY = -math.huge, -math.huge
    local anyInFront = false

    for _, offset in ipairs(corners) do
        local worldPoint = boxCFrame:PointToWorldSpace(offset)
        local screenPoint = Camera:WorldToScreenPoint(worldPoint)
        if screenPoint.Z > 0 then
            anyInFront = true
            minX = math.min(minX, screenPoint.X)
            minY = math.min(minY, screenPoint.Y)
            maxX = math.max(maxX, screenPoint.X)
            maxY = math.max(maxY, screenPoint.Y)
        end
    end

    if not anyInFront then return nil end
    return minX, minY, maxX, maxY
end

local function UpdateESP()
    if not ESP_Enabled then
        for _, data in pairs(ESP_Storage) do
            data.Container.Visible = false
            data.Tracer.Visible = false
        end
        return
    end

    Camera = Workspace.CurrentCamera
    if not Camera then return end

    local viewport = Camera.ViewportSize
    local screenBottom = Vector2.new(viewport.X / 2, viewport.Y)

    for player, data in pairs(ESP_Storage) do
        local char = data.Char
        if not char or not char.Parent then
            data.Container.Visible = false
            data.Tracer.Visible = false
            continue
        end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")

        if not hrp or not hum or hum.Health <= 0 then
            data.Container.Visible = false
            data.Tracer.Visible = false
            continue
        end

        local minX, minY, maxX, maxY = GetScreenBounds(char)
        if not minX then
            data.Container.Visible = false
            data.Tracer.Visible = false
            continue
        end

        local width = math.max(maxX - minX, 18)
        local height = math.max(maxY - minY, 30)
        local centerX = (minX + maxX) / 2
        local centerY = (minY + maxY) / 2

        local color = IsTeammate(player) and Color3.fromRGB(50, 255, 100) or Color3.fromRGB(255, 60, 60)

        data.Container.Size = UDim2.fromOffset(width, height)
        data.Container.Position = UDim2.fromOffset(centerX - width / 2, centerY - height / 2)
        data.Container.Visible = true
        data.Stroke.Color = color

        local maxHealth = hum.MaxHealth
        if maxHealth > 0 then
            local percent = math.clamp(hum.Health / maxHealth, 0, 1)
            data.HpBar.Size = UDim2.new(1, 0, percent, 0)
            data.HpBar.Position = UDim2.new(0, 0, 1 - percent, 0)
            data.HpBar.BackgroundColor3 = Color3.fromRGB(255 * (1 - percent), 255 * percent, 60)
            data.HpBg.Visible = true
        else
            data.HpBg.Visible = false
        end

        local distance = (hrp.Position - Camera.CFrame.Position).Magnitude
        data.Dist.Text = math.floor(distance) .. " studs"

        local boxBottom = Vector2.new(centerX, maxY)
        local diff = boxBottom - screenBottom
        local length = diff.Magnitude

        if length > 1 then
            data.Tracer.Position = UDim2.fromOffset(screenBottom.X, screenBottom.Y)
            data.Tracer.Size = UDim2.fromOffset(length, 1.2)
            data.Tracer.Rotation = math.deg(math.atan2(diff.Y, diff.X))
            data.Tracer.BackgroundColor3 = color
            data.Tracer.Visible = true
        else
            data.Tracer.Visible = false
        end
    end
end

