local FOVStroke = Instance.new("UIStroke")
FOVStroke.Color = Color3.fromRGB(0, 170, 255)
FOVStroke.Thickness = 1.5
FOVStroke.Parent = FOVCircle

local AimbotFOV = 100 -- radius in pixels

local function GetClosestInFOV()
    local closest, shortest = nil, AimbotFOV
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
            if IsTeammate(player) then continue end -- Skip teammates

            local pos, onScreen = Camera:WorldToViewportPoint(player.Character.Head.Position)
            if onScreen and pos.Z > 0 then
                local d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                if d < shortest then
                    shortest = d
                    closest = player
                end
            end
        end
    end
    return closest
end

local function ToggleAimbot(state)
    if state then
        FOVCircle.Visible = true
        Notify("Aimbot", "Enabled | FOV: " .. AimbotFOV, 2)
        AimbotConnection = RunService.RenderStepped:Connect(function()
            if not Aimbot_Enabled then return end
            local target = GetClosestInFOV()
            if target and target.Character and target.Character:FindFirstChild("Head") then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Character.Head.Position)
            end
        end)
    else
        FOVCircle.Visible = false
        Notify("Aimbot", "Disabled", 2)
        if AimbotConnection then
            AimbotConnection:Disconnect()
            AimbotConnection = nil
        end
    end
end

