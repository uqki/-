local OriginalNamecall
OriginalNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}

    if Settings.SilentAim and (method == "FireServer" or method == "InvokeServer") then
        -- 武器のリモートイベントを検出して書き換え
        local target = GetClosestPlayerToMouse()
        if target then
            local character = GetCharacter(target)
            local targetPart = character and character:FindFirstChild(Settings.SilentAimHitpart)
            if targetPart then
                -- 位置引数を探して書き換え
                for i, arg in ipairs(args) do
                    if typeof(arg) == "Vector3" then
                        args[i] = targetPart.Position + (targetPart.Velocity * 0.05)
                    elseif typeof(arg) == "CFrame" then
                        args[i] = CFrame.new(targetPart.Position + (targetPart.Velocity * 0.05))
                    elseif typeof(arg) == "Instance" and arg:IsA("BasePart") then
                        args[i] = targetPart
                    end
                end
            end
        end
    end

    return OriginalNamecall(self, unpack(args))
end)

--======================================
-- メインループ
--======================================
RunService.RenderStepped:Connect(function()
    -- ESP更新
    if Settings.ESP then
        UpdateESP()
    else
        for _, espData in pairs(ESPObjects) do
            if espData.Box then espData.Box.Visible = false end
            if espData.Name then espData.Name.Visible = false end
            if espData.Health then espData.Health.Visible = false end
            if espData.Tracer then espData.Tracer.Visible = false end
        end
    end

    -- Triggerbot
    if Settings.Triggerbot then
        local target = GetClosestPlayerToMouse()
        if target then
            local character = GetCharacter(target)
            local head = character and GetHead(character)
            if head then
                local screenPos = Camera:WorldToViewportPoint(head.Position)
                local mousePos = UserInputService:GetMouseLocation()
                local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                if dist < 20 then
                    -- マウスクリックをシミュレート
                    mouse1click()
                end
            end
        end
    end

    -- Auto Attack (ナイフ近接)
    if Settings.AutoAttack then
        local target, distance = GetClosestPlayer()
        if target and distance <= Settings.AutoAttackRange then
            local character = GetCharacter(target)
            local targetPart = character and (character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head"))
            if targetPart then
                -- ツールを探して攻撃
                local myCharacter = GetCharacter(LocalPlayer)
                if myCharacter then
                    for _, tool in ipairs(myCharacter:GetChildren()) do
                        if tool:IsA("Tool") then
                            tool:Activate()
                        end
                    end
                end
            end
        end
    end

    -- Speed Modifier
    if Settings.SpeedEnabled then
        local myCharacter = GetCharacter(LocalPlayer)
        local humanoid = myCharacter and GetHumanoid(myCharacter)
        if humanoid then
            humanoid.WalkSpeed = Settings.SpeedValue
        end
    end

    -- Anti Aim
    if Settings.AntiAim then
        local myCharacter = GetCharacter(LocalPlayer)
        local humanoid = myCharacter and GetHumanoid(myCharacter)
        local rootPart = myCharacter and GetRootPart(myCharacter)
        if humanoid and rootPart then
            rootPart.CFrame = rootPart.CFrame * CFrame.Angles(0, math.random() * math.pi * 2, 0)
        end
    end
end)

