--======================================
-- ユーティリティ関数
--======================================
local function GetCharacter(player)
    return player and player.Character
end

local function GetHumanoid(character)
    return character and character:FindFirstChildOfClass("Humanoid")
end

local function GetRootPart(character)
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function GetHead(character)
    return character and character:FindFirstChild("Head")
end

local function IsAlive(character)
    local humanoid = GetHumanoid(character)
    return humanoid and humanoid.Health > 0
end

local function IsEnemy(player)
    if player == LocalPlayer then return false end
    if not player or not player.Character then return false end
    local myTeam = LocalPlayer.Team
    local theirTeam = player.Team
    -- チームゲームの場合はチームで判定、ソロなら全員敵
    if myTeam and theirTeam and myTeam ~= theirTeam then
        return true
    elseif not myTeam or not theirTeam then
        return true
    end
    return false
end

local function GetClosestPlayerToMouse()
    local closestPlayer = nil
    local shortestDistance = Settings.SilentAimFOV
    local mousePos = UserInputService:GetMouseLocation()

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and IsEnemy(player) then
            local character = GetCharacter(player)
            if character and IsAlive(character) then
                local targetPart = character:FindFirstChild(Settings.SilentAimHitpart) or character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
                if targetPart then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                    if onScreen then
                        local distance = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                        if distance < shortestDistance then
                            shortestDistance = distance
                            closestPlayer = player
                        end
                    end
                end
            end
        end
    end

    return closestPlayer
end

local function GetClosestPlayer()
    local closestPlayer = nil
    local shortestDistance = math.huge
    local myCharacter = GetCharacter(LocalPlayer)
    local myRoot = myCharacter and GetRootPart(myCharacter)

    if not myRoot then return nil end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and IsEnemy(player) then
            local character = GetCharacter(player)
            if character and IsAlive(character) then
                local targetRoot = GetRootPart(character)
                if targetRoot then
                    local distance = (myRoot.Position - targetRoot.Position).Magnitude
                    if distance < shortestDistance then
                        shortestDistance = distance
                        closestPlayer = player
                    end
                end
            end
        end
    end

    return closestPlayer, shortestDistance
end

--======================================
-- ESPシステム
--======================================
local ESPObjects = {}

local function CreateESP(player)
    if ESPObjects[player] then return end

    local espData = {
        Box = nil,
        Name = nil,
        Health = nil,
        Tracer = nil
    }

    -- Box
    local box = Drawing.new("Square")
    box.Visible = false
    box.Thickness = 1.5
    box.Color = Settings.ESPColor
    box.Filled = false
    box.Transparency = 1
    espData.Box = box

    -- Name
    local name = Drawing.new("Text")
    name.Visible = false
    name.Size = 14
    name.Color = Color3.fromRGB(255, 255, 255)
    name.Center = true
    name.Outline = true
    name.OutlineColor = Color3.fromRGB(0, 0, 0)
    espData.Name = name

    -- Health
    local health = Drawing.new("Text")
    health.Visible = false
    health.Size = 12
    health.Color = Color3.fromRGB(0, 255, 100)
    health.Center = true
    health.Outline = true
    health.OutlineColor = Color3.fromRGB(0, 0, 0)
    espData.Health = health

    -- Tracer
    local tracer = Drawing.new("Line")
    tracer.Visible = false
    tracer.Thickness = 1
    tracer.Color = Settings.ESPColor
    tracer.Transparency = 0.7
    espData.Tracer = tracer

    ESPObjects[player] = espData
end

local function RemoveESP(player)
    local espData = ESPObjects[player]
    if not espData then return end
    if espData.Box then espData.Box:Remove() end
    if espData.Name then espData.Name:Remove() end
    if espData.Health then espData.Health:Remove() end
    if espData.Tracer then espData.Tracer:Remove() end
    ESPObjects[player] = nil
end

local function UpdateESP()
    for player, espData in pairs(ESPObjects) do
        if not player or not player.Parent then
            RemoveESP(player)
        else
            local character = GetCharacter(player)
            local humanoid = character and GetHumanoid(character)
            local rootPart = character and GetRootPart(character)
            local head = character and GetHead(character)

            if character and IsAlive(character) and rootPart and head and IsEnemy(player) then
                local headPos, headOnScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                local rootPos, rootOnScreen = Camera:WorldToViewportPoint(rootPart.Position - Vector3.new(0, 3, 0))

                if headOnScreen and rootOnScreen then
                    local boxHeight = math.abs(headPos.Y - rootPos.Y)
                    local boxWidth = boxHeight * 0.6

                    -- Box
                    if Settings.ESPBox then
                        espData.Box.Visible = true
                        espData.Box.Size = Vector2.new(boxWidth, boxHeight)
                        espData.Box.Position = Vector2.new(headPos.X - boxWidth / 2, headPos.Y)
                        espData.Box.Color = Settings.ESPColor
                    else
                        espData.Box.Visible = false
                    end

                    -- Name
                    if Settings.ESPName then
                        espData.Name.Visible = true
                        espData.Name.Position = Vector2.new(headPos.X, headPos.Y - 18)
                        espData.Name.Text = player.Name
                    else
                        espData.Name.Visible = false
                    end

                    -- Health
                    if Settings.ESPHealth and humanoid then
                        espData.Health.Visible = true
                        espData.Health.Position = Vector2.new(headPos.X, headPos.Y - 32)
                        espData.Health.Text = math.floor(humanoid.Health) .. "/" .. math.floor(humanoid.MaxHealth)
                        local hpPercent = humanoid.Health / humanoid.MaxHealth
                        if hpPercent > 0.6 then
                            espData.Health.Color = Color3.fromRGB(0, 255, 100)
                        elseif hpPercent > 0.3 then
                            espData.Health.Color = Color3.fromRGB(255, 255, 0)
                        else
                            espData.Health.Color = Color3.fromRGB(255, 0, 0)
                        end
                    else
                        espData.Health.Visible = false
                    end

                    -- Tracer
                    if Settings.ESPTracer then
                        espData.Tracer.Visible = true
                        espData.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        espData.Tracer.To = Vector2.new(rootPos.X, rootPos.Y)
                        espData.Tracer.Color = Settings.ESPColor
                    else
                        espData.Tracer.Visible = false
                    end
                else
                    espData.Box.Visible = false
                    espData.Name.Visible = false
                    espData.Health.Visible = false
                    espData.Tracer.Visible = false
                end
            else
                espData.Box.Visible = false
                espData.Name.Visible = false
                espData.Health.Visible = false
                espData.Tracer.Visible = false
            end
        end
    end
end

