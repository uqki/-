local camera = workspace.CurrentCamera
local screenGui = Instance.new("ScreenGui")
local mainFrame = Instance.new("Frame")
local espToggle = Instance.new("TextButton")
local wallhackToggle = Instance.new("TextButton")
local aimbotToggle = Instance.new("TextButton")

screenGui.Name = "CheatGUI"
screenGui.Parent = player:WaitForChild("PlayerGui")

mainFrame.Size = UDim2.new(0, 200, 0, 150)
mainFrame.Position = UDim2.new(0, 10, 0, 10)
mainFrame.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
mainFrame.Parent = screenGui

espToggle.Text = "ESP: OFF"
espToggle.Size = UDim2.new(1, -10, 0, 30)
espToggle.Position = UDim2.new(0, 5, 0, 10)
espToggle.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
espToggle.Parent = mainFrame

wallhackToggle.Text = "Wallhack: OFF"
wallhackToggle.Size = UDim2.new(1, -10, 0, 30)
wallhackToggle.Position = UDim2.new(0, 5, 0, 50)
wallhackToggle.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
wallhackToggle.Parent = mainFrame

aimbotToggle.Text = "Aimbot: OFF"
aimbotToggle.Size = UDim2.new(1, -10, 0, 30)
aimbotToggle.Position = UDim2.new(0, 5, 0, 90)
aimbotToggle.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
aimbotToggle.Parent = mainFrame

-- 通知関数
local StarterGui = game:GetService("StarterGui")
local function Notify(title, text, duration) 
    StarterGui:SetCore("SendNotification", { 
        Title = title, 
        Text = text, 
        Duration = duration 
    }) 
end

-- 変数
local ESPEnabled = false
local WallhackEnabled = false
local AimbotEnabled = false
local connections = {}

-- ESP
espToggle.MouseButton1Click:Connect(function()
    ESPEnabled = not ESPEnabled
    espToggle.Text = "ESP: " .. (ESPEnabled and "ON" or "OFF")
    if ESPEnabled then
        for _, v in pairs(workspace:GetChildren()) do
            if v:IsA("Model") and v:FindFirstChild("Head") then
                local box = Instance.new("BoxHandleAdornment")
                box.Adornee = v
                box.AlwaysOnTop = true
                box.Size = v:GetExtentsSize()
                box.Color3 = Color3.new(1, 0, 0)
                box.Transparency = 0.5
                box.ZIndex = 0
                box.Parent = game.CoreGui
                table.insert(connections, box)
            end
        end
    else
        for _, conn in pairs(connections) do
            if conn:IsA("BoxHandleAdornment") then
                conn:Destroy()
            end
        end
        connections = {}
    end
end)

-- Wallhack
wallhackToggle.MouseButton1Click:Connect(function()
    WallhackEnabled = not WallhackEnabled
    wallhackToggle.Text = "Wallhack: " .. (WallhackEnabled and "ON" or "OFF")
    if WallhackEnabled then
        for _, part in pairs(workspace:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.Material = Enum.Material.ForceField
                part.Transparency = 0.5
                table.insert(connections, part)
            end
        end
    else
        for _, conn in pairs(connections) do
            if conn:IsA("BasePart") then
                conn.Material = Enum.Material.Plastic
                conn.Transparency = 0
            end
        end
    end
end)

-- Aimbot
aimbotToggle.MouseButton1Click:Connect(function()
    AimbotEnabled = not AimbotEnabled
    aimbotToggle.Text = "Aimbot: " .. (AimbotEnabled and "ON" or "OFF")
    if AimbotEnabled then
        local connection = game:GetService("RunService").Heartbeat:Connect(function()
            if AimbotEnabled then
                for _, plr in pairs(game.Players:GetPlayers()) do
                    if plr ~= player and plr.Character and plr.Character:FindFirstChild("Head") then
                        camera.CFrame = CFrame.lookAt(camera.CFrame.Position, plr.Character.Head.Position)
                    end
                end
            end
        end)
        table.insert(connections, connection)
    else
        for _, conn in pairs(connections) do
            if conn.Connected then
                conn:Disconnect()
            end
        end
    end
end)

Notify("Cheat GUI", "GUI has been loaded successfully!", 3)
