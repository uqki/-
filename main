
--// Obsidian Mobile Cheat v13
--// UI: deividcomsono/Obsidian (Official Only)
--// Fixed: Void Drop now uses Instant Kill combo to bypass server position rollback

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local StarterGui = game:GetService("StarterGui")

local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

--// ============================================
--// CONNECTION MANAGER
--// ============================================
local ActiveConnections = {}
local function TrackConnection(con)
    table.insert(ActiveConnections, con)
    return con
end

--// ============================================
--// CONFIG
--// ============================================
local CheatConfig = {
    ESP = {
        Enabled = false,
        Boxes = true,
        Names = true,
        Distance = true,
        Tracers = true,
        TeamCheck = true,
        Color = Color3.fromRGB(230, 57, 70),
        TeamColor = Color3.fromRGB(0, 255, 136)
    },
    NoClip = false,
    InfiniteJump = false
}

--// ============================================
--// UTILITIES
--// ============================================
local function GetRootPart(character)
    if not character then return nil end
    return character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso")
end

local function GetHumanoid(character)
    return character and character:FindFirstChildOfClass("Humanoid")
end

local function IsTeamMate(player)
    if not CheatConfig.ESP.TeamCheck then return false end
    if not LocalPlayer.Team then return false end
    return player.Team == LocalPlayer.Team
end

local function WorldToViewport(pos)
    local screenPos, onScreen = Camera:WorldToViewportPoint(pos)
    return Vector2.new(screenPos.X, screenPos.Y), onScreen, screenPos.Z
end

--// ============================================
--// ESP SYSTEM
--// ============================================
local Drawing = Drawing or {}
local ESPObjects = {}

local function CreateDrawing(type, properties)
    local drawing = Drawing.new(type)
    for prop, value in pairs(properties) do
        drawing[prop] = value
    end
    return drawing
end

local function CreateESP(player)
    if player == LocalPlayer then return end
    local esp = {
        Box = CreateDrawing("Square", {Thickness = 1, Filled = false, Visible = false}),
        BoxOutline = CreateDrawing("Square", {Thickness = 3, Filled = false, Visible = false, Color = Color3.fromRGB(0,0,0)}),
        Name = CreateDrawing("Text", {Size = 13, Center = true, Outline = true, Visible = false}),
        Distance = CreateDrawing("Text", {Size = 12, Center = true, Outline = true, Visible = false}),
        Tracer = CreateDrawing("Line", {Thickness = 1, Visible = false}),
        TracerOutline = CreateDrawing("Line", {Thickness = 3, Visible = false, Color = Color3.fromRGB(0,0,0)})
    }
    ESPObjects[player] = esp
end

local function RemoveESP(player)
    local esp = ESPObjects[player]
    if not esp then return end
    for _, obj in pairs(esp) do
        pcall(function() obj:Remove() end)
    end
    ESPObjects[player] = nil
end

local function UpdateESP()
    for player, esp in pairs(ESPObjects) do
        local success = pcall(function()
            local character = player.Character
            local rootPart = GetRootPart(character)
            local head = character and character:FindFirstChild("Head")
            local humanoid = GetHumanoid(character)
            
            if not character or not rootPart or not head or not humanoid or humanoid.Health <= 0 then
                for _, obj in pairs(esp) do obj.Visible = false end
                return
            end
            
            if not CheatConfig.ESP.Enabled then
                for _, obj in pairs(esp) do obj.Visible = false end
                return
            end
            
            local isTeam = IsTeamMate(player)
            local color = isTeam and CheatConfig.ESP.TeamColor or CheatConfig.ESP.Color
            
            local headPos, headOnScreen = WorldToViewport(head.Position + Vector3.new(0, 0.5, 0))
            local rootPos, rootOnScreen = WorldToViewport(rootPart.Position - Vector3.new(0, 3, 0))
            
            if not headOnScreen and not rootOnScreen then
                for _, obj in pairs(esp) do obj.Visible = false end
                return
            end
            
            local boxHeight = math.abs(headPos.Y - rootPos.Y)
            local boxWidth = boxHeight * 0.6
            
            if CheatConfig.ESP.Boxes then
                esp.BoxOutline.Size = Vector2.new(boxWidth, boxHeight)
                esp.BoxOutline.Position = Vector2.new(rootPos.X - boxWidth / 2, rootPos.Y - boxHeight)
                esp.BoxOutline.Visible = true
                esp.Box.Size = Vector2.new(boxWidth, boxHeight)
                esp.Box.Position = Vector2.new(rootPos.X - boxWidth / 2, rootPos.Y - boxHeight)
                esp.Box.Color = color
                esp.Box.Visible = true
            else
                esp.Box.Visible = false
                esp.BoxOutline.Visible = false
            end
            
            if CheatConfig.ESP.Names then
                esp.Name.Position = Vector2.new(rootPos.X, rootPos.Y - boxHeight - 15)
                esp.Name.Text = player.Name
                esp.Name.Color = color
                esp.Name.Visible = true
            else
                esp.Name.Visible = false
            end
            
            if CheatConfig.ESP.Distance then
                local myRoot = GetRootPart(LocalPlayer.Character)
                local dist = myRoot and math.floor((myRoot.Position - rootPart.Position).Magnitude) or 0
                esp.Distance.Position = Vector2.new(rootPos.X, rootPos.Y + 5)
                esp.Distance.Text = dist .. "m"
                esp.Distance.Color = color
                esp.Distance.Visible = true
            else
                esp.Distance.Visible = false
            end
            
            if CheatConfig.ESP.Tracers then
                local origin = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                esp.TracerOutline.From = origin
                esp.TracerOutline.To = Vector2.new(rootPos.X, rootPos.Y)
                esp.TracerOutline.Visible = true
                esp.Tracer.From = origin
                esp.Tracer.To = Vector2.new(rootPos.X, rootPos.Y)
                esp.Tracer.Color = color
                esp.Tracer.Visible = true
            else
                esp.Tracer.Visible = false
                esp.TracerOutline.Visible = false
            end
        end)
        
        if not success then
            for _, obj in pairs(esp) do
                pcall(function() obj.Visible = false end)
            end
        end
    end
end

for _, player in ipairs(Players:GetPlayers()) do
    pcall(function() CreateESP(player) end)
end

TrackConnection(Players.PlayerAdded:Connect(function(player)
    pcall(function() CreateESP(player) end)
end))

TrackConnection(Players.PlayerRemoving:Connect(function(player)
    pcall(function() RemoveESP(player) end)
end))

TrackConnection(RunService.RenderStepped:Connect(UpdateESP))

TrackConnection(Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
    Camera = Workspace.CurrentCamera
end))

--// ============================================
--// MOVEMENT
--// ============================================
TrackConnection(UserInputService.JumpRequest:Connect(function()
    if not CheatConfig.InfiniteJump then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hum = GetHumanoid(char)
    if hum then
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
    end
end))

local NoclipParts = {}
local function RefreshNoclipParts()
    NoclipParts = {}
    local char = LocalPlayer.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            table.insert(NoclipParts, part)
        end
    end
end

TrackConnection(LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(0.5)
    RefreshNoclipParts()
end))

if LocalPlayer.Character then
    RefreshNoclipParts()
end

TrackConnection(RunService.Stepped:Connect(function()
    if not CheatConfig.NoClip then return end
    for _, part in ipairs(NoclipParts) do
        if part and part.Parent then
            pcall(function() part.CanCollide = false end)
        end
    end
end))

--// ============================================
--// TELEPORT BEHIND (v8 Confirmed Logic)
--// ============================================
local function TeleportBehindPlayer(targetPlayer)
    if not targetPlayer or targetPlayer == LocalPlayer then
        return false, "Invalid target"
    end
    if typeof(targetPlayer) ~= "Instance" or not targetPlayer:IsA("Player") then
        return false, "Invalid player object"
    end
    
    local targetChar = targetPlayer.Character
    if not targetChar then
        return false, targetPlayer.Name .. " has no character"
    end
    
    local targetHRP = GetRootPart(targetChar)
    local myHRP = GetRootPart(LocalPlayer.Character)
    
    if not targetHRP then
        return false, "Target has no root part"
    end
    if not myHRP then
        return false, "You have no root part"
    end
    
    local success, err = pcall(function()
        local behindOffset = targetHRP.CFrame.LookVector * -5
        local behindPos = targetHRP.CFrame.Position + behindOffset
        myHRP.CFrame = CFrame.new(behindPos, targetHRP.CFrame.Position)
    end)
    
    if success then
        return true, "Teleported behind " .. targetPlayer.Name
    else
        return false, tostring(err)
    end
end

--// ============================================
--// VOID DROP + INSTANT KILL COMBO
--// ============================================
--// NOTE: Other players' positions are managed by the server.
--// Pure CFrame rewriting is instantly rolled back by the server.
--// Therefore, we combine forced CFrame + Instant Kill (Health=0)
--// to make the player respawn from the void.
local function DropPlayerToVoid(targetPlayer)
    if not targetPlayer or targetPlayer == LocalPlayer then
        return false, "Invalid target"
    end
    if typeof(targetPlayer) ~= "Instance" or not targetPlayer:IsA("Player") then
        return false, "Invalid player object"
    end
    
    local targetChar = targetPlayer.Character
    if not targetChar then
        return false, targetPlayer.Name .. " has no character"
    end
    
    local hrp = GetRootPart(targetChar)
    local humanoid = GetHumanoid(targetChar)
    if not hrp then
        return false, "Target has no root part"
    end
    
    Library:Notify({ Title = "Void Drop", Description = "Executing on " .. targetPlayer.Name .. "...", Time = 2 })
    
    local startTime = tick()
    local originalChar = targetChar
    local conn
    
    conn = RunService.Heartbeat:Connect(function()
        local ok = pcall(function()
            -- Safety checks
            if not targetPlayer or not targetPlayer.Parent then
                if conn then conn:Disconnect() end
                return
            end
            if targetPlayer.Character ~= originalChar then
                if conn then conn:Disconnect() end
                return
            end
            
            local currentChar = targetPlayer.Character
            if not currentChar then
                if conn then conn:Disconnect() end
                return
            end
            
            local currentHRP = GetRootPart(currentChar)
            local currentHum = GetHumanoid(currentChar)
            if not currentHRP or not currentHum then
                if conn then conn:Disconnect() end
                return
            end
            
            local voidY = workspace.FallenPartsDestroyHeight - 500
            if voidY > -10000 then voidY = -10000 end
            
            -- Force position to void every frame
            currentHRP.AssemblyLinearVelocity = Vector3.new(0, -5000, 0)
            currentHRP.Velocity = Vector3.new(0, -5000, 0)
            currentHRP.RotVelocity = Vector3.new(0, 0, 0)
            currentHRP.CFrame = CFrame.new(currentHRP.Position.X, voidY, currentHRP.Position.Z)
            
            -- Force kill every frame (bypass server rollback by killing before rollback)
            currentHum.Sit = true
            currentHum.PlatformStand = true
            currentHum.AutoRotate = false
            currentHum.WalkSpeed = 0
            currentHum.JumpPower = 0
            currentHum.Health = 0
            
            pcall(function()
                currentHum:ChangeState(Enum.HumanoidStateType.Dead)
            end)
        end)
        
        if not ok then
            if conn then conn:Disconnect() end
        end
        
        if tick() - startTime > 3 then
            if conn then conn:Disconnect() end
            Library:Notify({ Title = "Void Drop", Description = "Finished attempt on " .. targetPlayer.Name, Time = 2 })
        end
    end)
    
    TrackConnection(conn)
    return true, "Dropping " .. targetPlayer.Name
end

--// ============================================
--// INSTANT KILL (Standalone)
--// ============================================
local function InstantKill(targetPlayer)
    if not targetPlayer or targetPlayer == LocalPlayer then
        return false, "Invalid target"
    end
    if typeof(targetPlayer) ~= "Instance" or not targetPlayer:IsA("Player") then
        return false, "Invalid player object"
    end
    
    local targetChar = targetPlayer.Character
    if not targetChar then
        return false, targetPlayer.Name .. " has no character"
    end
    
    local humanoid = GetHumanoid(targetChar)
    local hrp = GetRootPart(targetChar)
    if not humanoid then
        return false, "Target has no humanoid"
    end
    
    local success = pcall(function()
        humanoid.Health = 0
        humanoid.Sit = true
        humanoid.PlatformStand = true
        pcall(function()
            humanoid:ChangeState(Enum.HumanoidStateType.Dead)
        end)
        if hrp then
            hrp.AssemblyLinearVelocity = Vector3.new(0, -1000, 0)
        end
    end)
    
    if success then
        return true, "Killed " .. targetPlayer.Name
    else
        return false, "Failed to kill " .. targetPlayer.Name
    end
end

--// ============================================
--// LOAD OBSIDIAN UI LIBRARY
--// ============================================
local function SafeHttpGet(url)
    local methods = {
        function() return game:HttpGet(url, true) end,
        function() return game.HttpGet(game, url) end,
        function() 
            if syn and syn.request then
                local r = syn.request({Url = url, Method = "GET"})
                return r and r.Body
            end
            return nil
        end,
        function()
            if _G.http_request then
                local r = _G.http_request({Url = url, Method = "GET"})
                return r and r.Body
            end
            return nil
        end,
        function()
            if request then
                local r = request({Url = url, Method = "GET"})
                return r and r.Body
            end
            return nil
        end
    }
    
    for _, method in ipairs(methods) do
        local ok, res = pcall(method)
        if ok and res and #res > 0 then
            return res
        end
    end
    return nil
end

local repo = "https://raw.githubusercontent.com/deividcomsono/Obsidian/main/"

local libCode = SafeHttpGet(repo .. "Library.lua")
local themeCode = SafeHttpGet(repo .. "addons/ThemeManager.lua")
local saveCode = SafeHttpGet(repo .. "addons/SaveManager.lua")

if not libCode then
    StarterGui:SetCore("SendNotification", {
        Title = "Obsidian UI Error",
        Text = "Failed to fetch Library.lua. Check internet/executor.",
        Duration = 5
    })
    return
end

if not themeCode then
    StarterGui:SetCore("SendNotification", {
        Title = "Obsidian UI Error",
        Text = "Failed to fetch ThemeManager.lua. Check internet/executor.",
        Duration = 5
    })
    return
end

if not saveCode then
    StarterGui:SetCore("SendNotification", {
        Title = "Obsidian UI Error",
        Text = "Failed to fetch SaveManager.lua. Check internet/executor.",
        Duration = 5
    })
    return
end

local loadLibOk, Library = pcall(function()
    return loadstring(libCode)()
end)

if not loadLibOk or not Library then
    StarterGui:SetCore("SendNotification", {
        Title = "Obsidian UI Error",
        Text = "Failed to parse Library.lua: " .. tostring(Library),
        Duration = 5
    })
    return
end

local loadThemeOk, ThemeManager = pcall(function()
    return loadstring(themeCode)()
end)

if not loadThemeOk then
    StarterGui:SetCore("SendNotification", {
        Title = "Obsidian UI Error",
        Text = "Failed to parse ThemeManager.lua: " .. tostring(ThemeManager),
        Duration = 5
    })
    return
end

local loadSaveOk, SaveManager = pcall(function()
    return loadstring(saveCode)()
end)

if not loadSaveOk then
    StarterGui:SetCore("SendNotification", {
        Title = "Obsidian UI Error",
        Text = "Failed to parse SaveManager.lua: " .. tostring(SaveManager),
        Duration = 5
    })
    return
end

local Options = Library.Options
local Toggles = Library.Toggles

--// ============================================
--// BUILD OBSIDIAN UI
--// ============================================
local buildOk, buildErr = pcall(function()
    Library.ShowToggleFrameInKeybinds = true
    Library.ForceCheckbox = false
    
    local Window = Library:CreateWindow({
        Title = "OBSIDIAN",
        Footer = "Mobile Cheat",
        Icon = 95816097006870,
        NotifySide = "Right",
        ShowCustomCursor = false,
        MobileButtonsSide = "Left",
    })
    
    local Tabs = {
        Visual = Window:AddTab("Visual", "eye"),
        Movement = Window:AddTab("Movement", "move"),
        Target = Window:AddTab("Target", "crosshair"),
        UISettings = Window:AddTab("UI Settings", "settings"),
    }
    
    --// Visual Tab
    local VisualLeft = Tabs.Visual:AddLeftGroupbox("ESP Settings", "eye")
    
    VisualLeft:AddToggle("ESPEnabled", {
        Text = "ESP Enabled",
        Default = false,
        Callback = function(Value)
            CheatConfig.ESP.Enabled = Value
        end
    })
    
    VisualLeft:AddToggle("ESPBoxes", {
        Text = "Boxes",
        Default = true,
        Callback = function(Value)
            CheatConfig.ESP.Boxes = Value
        end
    })
    
    VisualLeft:AddToggle("ESPNames", {
        Text = "Names",
        Default = true,
        Callback = function(Value)
            CheatConfig.ESP.Names = Value
        end
    })
    
    VisualLeft:AddToggle("ESPDistance", {
        Text = "Distance",
        Default = true,
        Callback = function(Value)
            CheatConfig.ESP.Distance = Value
        end
    })
    
    VisualLeft:AddToggle("ESPTracers", {
        Text = "Tracers",
        Default = true,
        Callback = function(Value)
            CheatConfig.ESP.Tracers = Value
        end
    })
    
    VisualLeft:AddToggle("ESPTeamCheck", {
        Text = "Team Check",
        Default = true,
        Callback = function(Value)
            CheatConfig.ESP.TeamCheck = Value
        end
    })
    
    --// Movement Tab
    local MoveLeft = Tabs.Movement:AddLeftGroupbox("Movement", "move")
    
    MoveLeft:AddToggle("NoClipToggle", {
        Text = "NoClip",
        Default = false,
        Callback = function(Value)
            CheatConfig.NoClip = Value
            if Value then
                RefreshNoclipParts()
            end
        end
    })
    
    MoveLeft:AddToggle("InfJumpToggle", {
        Text = "Infinite Jump",
        Default = false,
        Callback = function(Value)
            CheatConfig.InfiniteJump = Value
        end
    })
    
    --// Target Tab
    local TargetLeft = Tabs.Target:AddLeftGroupbox("Player Targeting", "crosshair")
    
    TargetLeft:AddDropdown("TargetPlayer", {
        SpecialType = "Player",
        ExcludeLocalPlayer = true,
        Text = "Select Target",
        Tooltip = "Choose a player to target",
    })
    
    local function ResolveTargetPlayer()
        local selected = Options.TargetPlayer.Value
        if not selected then
            return nil, "No player selected"
        end
        
        if typeof(selected) == "Instance" and selected:IsA("Player") then
            if selected == LocalPlayer then
                return nil, "Cannot target yourself"
            end
            if not selected.Parent then
                return nil, "Selected player has left"
            end
            return selected, nil
        end
        
        if type(selected) == "string" and selected ~= "" then
            local player = Players:FindFirstChild(selected)
            if not player then
                return nil, "Player '" .. selected .. "' not found"
            end
            if player == LocalPlayer then
                return nil, "Cannot target yourself"
            end
            return player, nil
        end
        
        return nil, "Invalid selection"
    end
    
    TargetLeft:AddButton({
        Text = "Void Drop",
        Func = function()
            local targetPlayer, err = ResolveTargetPlayer()
            if not targetPlayer then
                Library:Notify({ Title = "Error", Description = err, Time = 2 })
                return
            end
            local ok, msg = DropPlayerToVoid(targetPlayer)
            if not ok then
                Library:Notify({ Title = "Error", Description = msg, Time = 3 })
            end
        end,
        DoubleClick = false,
        Risky = true,
    })
    
    TargetLeft:AddButton({
        Text = "Instant Kill",
        Func = function()
            local targetPlayer, err = ResolveTargetPlayer()
            if not targetPlayer then
                Library:Notify({ Title = "Error", Description = err, Time = 2 })
                return
            end
            local ok, msg = InstantKill(targetPlayer)
            Library:Notify({ Title = ok and "Instant Kill" or "Error", Description = msg, Time = 3 })
        end,
        DoubleClick = false,
        Risky = true,
    })
    
    TargetLeft:AddButton({
        Text = "Teleport Behind",
        Func = function()
            local targetPlayer, err = ResolveTargetPlayer()
            if not targetPlayer then
                Library:Notify({ Title = "Error", Description = err, Time = 2 })
                return
            end
            local ok, msg = TeleportBehindPlayer(targetPlayer)
            Library:Notify({ Title = ok and "Teleport" or "Error", Description = msg, Time = 3 })
        end,
        DoubleClick = false,
    })
    
    --// UI Settings Tab
    local MenuGroup = Tabs.UISettings:AddLeftGroupbox("Menu", "settings")
    
    MenuGroup:AddToggle("KeybindMenuOpen", {
        Default = Library.KeybindFrame.Visible,
        Text = "Open Keybind Menu",
        Callback = function(value)
            Library.KeybindFrame.Visible = value
        end,
    })
    
    MenuGroup:AddLabel("Menu bind"):AddKeyPicker("MenuKeybind", {
        Default = "RightShift",
        NoUI = true,
        Text = "Menu keybind"
    })
    
    MenuGroup:AddButton("Unload", function()
        Library:Unload()
    end)
    
    Library.ToggleKeybind = Options.MenuKeybind
    
    ThemeManager:SetLibrary(Library)
    SaveManager:SetLibrary(Library)
    SaveManager:IgnoreThemeSettings()
    SaveManager:SetIgnoreIndexes({ "MenuKeybind" })
    ThemeManager:SetFolder("ObsidianCheat")
    SaveManager:SetFolder("ObsidianCheat/universal")
    ThemeManager:ApplyToTab(Tabs.UISettings)
    SaveManager:BuildConfigSection(Tabs.UISettings)
    SaveManager:LoadAutoloadConfig()
    
    Library:OnUnload(function()
        for _, con in ipairs(ActiveConnections) do
            pcall(function() con:Disconnect() end)
        end
        for _, esp in pairs(ESPObjects) do
            for _, obj in pairs(esp) do
                pcall(function() obj:Remove() end)
            end
        end
        ESPObjects = {}
        CheatConfig.NoClip = false
        CheatConfig.InfiniteJump = false
        CheatConfig.ESP.Enabled = false
    end)
    
    local execName = "Unknown"
    pcall(function()
        if identifyexecutor then
            execName = tostring(identifyexecutor())
        end
    end)
    
    Library:Notify({
        Title = "Obsidian Cheat",
        Description = "Loaded successfully on " .. execName,
        Time = 4
    })
end)

if not buildOk then
    StarterGui:SetCore("SendNotification", {
        Title = "Obsidian UI Error",
        Text = "Failed to build UI: " .. tostring(buildErr),
        Duration = 5
    })
    return
end
